{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "paths": {
      "@rova/shared/*": ["./packages/shared/src/*"],
      "@rova/core": ["./packages/core/src/index.ts"],
      "@rova/core/*": ["./packages/core/src/*"],
      "@rova/plugins": ["./packages/plugins/src/index.ts"],
      "@rova/plugins/*": ["./packages/plugins/src/*"],
      "@/backend/*": ["./packages/core/src/backend/*"],
      // `@/` means the importing package's own src, and this cannot say that:
      // tsc takes the first of the four that resolves, whoever wrote the import.
      // scripts/plugins/package-scoped-alias.ts is the rule as the bundler and
      // the test runner apply it, and .oxlintrc.json is what actually rejects a
      // cross-package `@/`. Node subpath imports (`#/`) would express the scope
      // per package and retire the divergence; until then the four entries here
      // are a superset that happens to work.
      "@/*": [
        "./packages/shared/src/*",
        "./packages/core/src/*",
        "./packages/client/src/*",
        "./packages/plugins/src/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "vite.config.ts",
    "vitest.config.ts",
    "test-setup.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/client/src/**/*.ts",
    "packages/client/src/**/*.tsx",
    "packages/core/drizzle.config.ts",
    "packages/core/tsdown.config.ts",
    "packages/client/tsdown.config.ts",
    "packages/plugins/src/**/*.ts",
    "packages/plugins/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "_upstream_template/**/*", "tmp/**/*"]
}
