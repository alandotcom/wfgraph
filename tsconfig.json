{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["bun-types", "node"],
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "paths": {
      "@rova/shared": ["./packages/shared/src"],
      "@rova/core": ["./packages/core/src/index.ts"],
      "@rova/core/*": ["./packages/core/src/*"],
      "@rova/plugins": ["./packages/plugins/src/index.ts"],
      "@rova/plugins/*": ["./packages/plugins/src/*"],
      "@/shared/*": ["./packages/shared/src/*"],
      "@/backend/*": ["./packages/core/src/backend/*"],
      // Shared only. This used to fall through to packages/plugins/src as well,
      // which is how packages/core came to write `import "@/plugins/twilio"` and
      // inline five vendor SDKs into the published bundle; that spelling no
      // longer resolves. The bare "@/*" below still reaches packages/plugins,
      // because that is how the plugins package refers to itself, so
      // `import "@/twilio/test"` from core would still compile. What catches
      // that is packages/core/src/published-imports.test.ts, which reads the
      // built bundle and fails on any import core does not declare.
      "@/plugins/*": ["./packages/shared/src/plugins/*"],
      "@/*": [
        "./packages/shared/src/*",
        "./packages/core/src/*",
        "./packages/core/client/*",
        "./packages/plugins/src/*"
      ]
    }
  },
  "include": [
    "server.ts",
    "examples/**/*.ts",
    "scripts/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/core/client/**/*.ts",
    "packages/core/client/**/*.tsx",
    "packages/core/drizzle.config.ts",
    "packages/core/tsdown.config.ts",
    "packages/plugins/src/**/*.ts",
    "packages/plugins/src/**/*.tsx"
  ],
  "exclude": ["node_modules", "_upstream_template/**/*", "tmp/**/*"]
}
