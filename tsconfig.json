{
  "$schema": "./node_modules/@effect/tsgo/schema.json",
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // For `vitest.config.ts` and `packages/client/vite.config.ts`, which spell
    // out the `.ts` on the one import they share. Nothing is emitted from here,
    // so the extension reaches the loader that reads those two files.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "types": ["node"],
    "strictNullChecks": true,
    "noImplicitReturns": true,
    "plugins": [
      {
        "name": "@effect/language-service",
        "includeSuggestionsInTsc": true,
        "ignoreEffectWarningsInTscExitCode": false,
        // These APIs are already used by the pinned Effect integration. Keep
        // new unstable exports visible instead of disabling the diagnostic.
        "allowedUnstableApis": [
          "@effect/ai-openai/OpenAiClient#layer",
          "@effect/ai-openai/OpenAiLanguageModel#model",
          "@effect/opentelemetry/OtelTracer#OtelTracer",
          "@effect/opentelemetry/OtelTracer#layerWithoutOtelTracer",
          "@effect/sql-sqlite-node/SqliteClient#layer",
          "@effect/vitest#it",
          "@effect/vitest#layer",
          "effect/ai/Chat#Chat",
          "effect/ai/Chat#fromPrompt",
          "effect/ai/LanguageModel#LanguageModel",
          "effect/ai/LanguageModel#make",
          "effect/ai/Prompt#Prompt",
          "effect/ai/Prompt#make",
          "effect/ai/Prompt#setSystem",
          "effect/ai/Response#FinishReason",
          "effect/ai/Response#StreamPart",
          "effect/ai/Response#Usage",
          "effect/ai/Response#makePart",
          "effect/ai/Tool#getJsonSchema",
          "effect/ai/Tool#getJsonSchemaFromSchema",
          "effect/ai/Tool#make",
          "effect/ai/Toolkit#Tools",
          "effect/ai/Toolkit#WithHandler",
          "effect/ai/Toolkit#make",
          "effect/http/FetchHttpClient#Fetch",
          "effect/http/FetchHttpClient#layer",
          "effect/http/Headers#Headers",
          "effect/http/Headers#get",
          "effect/http/HttpClient#HttpClient",
          "effect/http/HttpClientError#HttpClientError",
          "effect/http/HttpClientRequest#HttpClientRequest",
          "effect/http/HttpClientRequest#bodyJsonUnsafe",
          "effect/http/HttpClientRequest#bodyUrlParams",
          "effect/http/HttpClientRequest#make",
          "effect/http/HttpClientRequest#setHeaders",
          "effect/http/HttpClientResponse#HttpClientResponse",
          "effect/http/HttpMethod#HttpMethod"
        ],
        // Holds every tagged error and tagged class to a tag equal to its
        // class name. Service keys are package-qualified paths that no
        // built-in pattern produces, so services are left out.
        "keyPatterns": [
          { "target": "error", "pattern": "identifier" },
          { "target": "taggedClass", "pattern": "identifier" }
        ],
        "diagnosticSeverity": {
          "deterministicKeys": "error",
          "mapMapErrorToMapBoth": "error",
          // The suggested Effect.void loses the specific success type these
          // functions declare (e.g. `number | undefined`); the fix does not compile.
          "effectSucceedWithVoid": "off",
          // These sites annotate Schema.Number before an isFinite check on purpose:
          // Schema.Finite nests the description under `allOf`, where the editor's
          // field reader cannot see it.
          "schemaNumber": "off"
        }
      }
    ],
    "paths": {
      "@wfgraph/agent/*": ["./packages/agent/src/*"],
      "@wfgraph/shared/*": ["./packages/shared/src/*"],
      "@wfgraph/core": ["./packages/core/src/index.ts"],
      "@wfgraph/core/*": ["./packages/core/src/*"],
      "@wfgraph/client": ["./packages/client/src/index.ts"],
      "@wfgraph/plugins": ["./packages/plugins/src/index.ts"],
      "@wfgraph/plugins/*": ["./packages/plugins/src/*"]
    }
  },
  "include": [
    "vitest.config.ts",
    "vitest.reliability.config.ts",
    "packages/evals/vitest.evals.config.ts",
    "test-setup.ts",
    "examples/**/*.ts",
    "examples/**/*.tsx",
    "scripts/**/*.ts",
    "packages/agent/src/**/*.ts",
    "packages/shared/src/**/*.ts",
    "packages/shared/src/**/*.tsx",
    "packages/core/src/**/*.ts",
    "packages/core/src/**/*.tsx",
    "packages/client/src/**/*.ts",
    "packages/client/src/**/*.tsx",
    "packages/core/drizzle.config.ts",
    "packages/core/tsdown.config.ts",
    "packages/client/tsdown.config.ts",
    "packages/client/vite.config.ts",
    "packages/plugins/src/**/*.ts",
    "packages/plugins/src/**/*.tsx",
    "packages/evals/src/**/*.ts"
  ],
  "exclude": ["node_modules", "_upstream_template/**/*", "tmp/**/*"]
}
