# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
**/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
/.vitest-evals/
/vitest-results.json

# next.js
/.next/
/out/
/.swc/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
# Generated declarations land in dist/, which is ignored below. A blanket
# *.d.ts rule used to live here and it silently hid ~100 stale declarations
# that had been emitted next to their sources; without it, a stray emit shows
# up in git status instead of shadowing the real .ts files during a search.
*.tsbuildinfo
next-env.d.ts
.env*.local

tmp/

# The example app's SQLite database, created on first boot. The trailing glob
# also covers the -wal and -shm sidecars WAL mode opens beside it.
examples/wfgraph.sqlite*

.npm-cache/
*.log
**/.inngest/*.db
**/.inngest/*.db-journal
dist/

# Impeccable live-mode session journals: local recovery state, not project source
**/.impeccable/live/sessions/

# Reference checkouts cloned by scripts/prepare-effect.sh (local/agent only)
# so agents can read Effect's real source; never a CI or build input
.repos/effect

# Worktrees an agent creates to work on an isolated copy of the repo. A second
# checkout of the whole tree, so anything walking the repo would judge every
# file twice.
.claude/worktrees/
.impeccable/live

# TanStack Intent generate dump (domain map, skill spec, skill tree). Published
# skills are authored under packages/*/skills; do not commit this output.
_artifacts/
