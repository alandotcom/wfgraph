{
  "name": "ai-workflow-builder-template",
  "version": "0.1.0",
  "private": true,
  "packageManager": "bun@1.3.9",
  "license": "Apache-2.0",
  "description": "A template for building your own AI-driven workflow automation platform",
  "scripts": {
    "dev": "concurrently --kill-others-on-fail --names app,inngest --prefix-colors blue,magenta \"bun run dev:app\" \"bun run dev:inngest\"",
    "dev:app": "NODE_ENV=development INNGEST_DEV=http://localhost:8388 bun --hot src/backend/server/index.ts",
    "dev:inngest": "bun run inngest:dev",
    "build": "bun run src/scripts/migrate-prod.ts && bun build --target=bun --production --outdir=dist ./src/backend/server/index.ts",
    "start": "NODE_ENV=production bun dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "type-check": "bun run tsc --noEmit",
    "typecheck": "bun run tsc --noEmit",
    "check": "bun run ultracite check",
    "fix": "bun run ultracite fix",
    "db:generate": "bun run drizzle-kit generate",
    "db:migrate": "bun run drizzle-kit migrate",
    "db:push": "bun run drizzle-kit push",
    "db:studio": "bun run drizzle-kit studio",
    "inngest:dev": "sh -c 'until curl -sSf http://localhost:4017/api/inngest >/dev/null 2>/dev/null; do sleep 1; done; bun run inngest-cli dev --no-discovery -u http://localhost:4017/api/inngest -p 8388 --connect-gateway-port 8390 --connect-gateway-grpc-port 50062 --connect-executor-grpc-port 50063 --persist'"
  },
  "dependencies": {
    "@fountain-bio/acuity": "^0.0.25",
    "@hono/zod-validator": "^0.7.6",
    "@linear/sdk": "^63.2.0",
    "@logtape/logtape": "^2.0.2",
    "@logtape/pretty": "^2.0.2",
    "@mendable/firecrawl-js": "^4.6.2",
    "@monaco-editor/react": "^4.7.0",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@slack/web-api": "^7.12.0",
    "@tanstack/react-query": "^5.90.21",
    "@tanstack/react-router": "^1.159.5",
    "@vercel/og": "^0.8.5",
    "@vercel/sdk": "^1.17.1",
    "@xyflow/react": "^12.9.2",
    "ai": "^5.0.102",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cronstrue": "^3.12.0",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.44.7",
    "hono": "^4.11.9",
    "inngest": "^3.52.0",
    "jotai": "^2.15.1",
    "lucide-react": "^0.552.0",
    "motion": "^12.23.24",
    "nanoid": "^5.1.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.1",
    "react-dom": "19.2.1",
    "react-resizable-panels": "^3.0.6",
    "resend": "^6.4.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.3.1",
    "vaul": "^1.1.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@inngest/test": "^0.1.9",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "bun-plugin-tailwind": "^0.1.2",
    "bun-types": "^1.3.9",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.6",
    "inngest-cli": "^1.13.0",
    "tailwindcss": "^4",
    "tsx": "^4.19.0",
    "tw-animate-css": "^1.4.0",
    "typescript": "^5",
    "ultracite": "6.3.0"
  },
  "trustedDependencies": [
    "bun",
    "inngest-cli",
    "protobufjs"
  ]
}
