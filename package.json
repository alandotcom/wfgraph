{
  "name": "wfgraph",
  "version": "0.0.0",
  "private": true,
  "description": "Workflow Graph — visual workflow automation with a node-based editor and plugin integrations",
  "license": "Apache-2.0",
  "type": "module",
  "scripts": {
    "prepare": "effect-tsgo patch --tsrs",
    "dev": "tsx scripts/dev.ts",
    "dev:app": "pnpm --filter @wfgraph/example-app dev",
    "build": "pnpm -r build",
    "package:smoke": "tsx scripts/smoke-core-package.ts",
    "start": "pnpm --filter @wfgraph/example-app start",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:postgres": "vitest run --project=postgres",
    "test:reliability": "vitest run --config vitest.reliability.config.ts",
    "evals": "pnpm --filter @wfgraph/evals evals",
    "type-check": "effect-tsgo tsrs --noEmit --fast",
    "typecheck": "effect-tsgo tsrs --noEmit --fast",
    "lint": "oxlint --type-aware .",
    "knip": "knip",
    "skills:validate": "intent validate --check",
    "skills:stale": "intent stale",
    "check": "oxfmt --check .",
    "fix": "oxfmt .",
    "db:generate": "pnpm exec drizzle-kit generate --config packages/core/drizzle.config.ts",
    "db:generate:sqlite": "pnpm exec drizzle-kit generate --config packages/core/drizzle-sqlite.config.ts && tsx scripts/validate-sqlite-migrations.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "executor:timing": "tsx scripts/executor-timing.ts",
    "release:version": "changeset version && pnpm install --lockfile-only",
    "release:publish": "pnpm run build && changeset publish"
  },
  "dependencies": {
    "dotenv": "^18.0.9"
  },
  "devDependencies": {
    "@changesets/changelog-github": "1.0.1",
    "@changesets/cli": "3.0.3",
    "@effect/tsgo": "0.67.7",
    "@effect/vitest": "catalog:",
    "@oxlint/plugins": "^1.91.0",
    "@tanstack/intent": "^0.5.6",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "catalog:",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^24.19.2",
    "@types/react": "catalog:",
    "@types/react-dom": "^19.3.0",
    "concurrently": "^10.0.6",
    "drizzle-kit": "1.0.0-rc.5",
    "esbuild": "^0.28.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-you-might-not-need-an-effect": "1.1.0",
    "happy-dom": "^21.0.4",
    "knip": "^6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.92.0",
    "pkg-pr-new": "^0.0.93",
    "tsdown": "^0.23.5",
    "tsrs": "0.23.0-ts7.1.0-beta",
    "tsx": "catalog:",
    "typescript": "^7.0.2",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@11.17.0"
}
