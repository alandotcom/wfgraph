{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  "jsPlugins": [
    { "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" },
    // Aliased because the package name is 43 characters and would otherwise
    // open every one of the nine rule lines below.
    {
      "name": "no-effect",
      "specifier": "eslint-plugin-react-you-might-not-need-an-effect"
    }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-console": "off",
    "no-var": "error",
    "prefer-const": "error",
    // A leading underscore marks a name this codebase keeps out of ordinary use.
    // Every such name is spelled out here, so introducing another one is a visible
    // decision and an accidental `_foo` is an error.
    //
    // `_context` and `_workflowComplete` are engine-internal fields on a step's
    // input record; `withStepLogging` reads them and strips them before the input
    // reaches the run log. `_g` and the key constants beside it are the
    // module-private handles the shared registries use to reach one instance across
    // bundles. The `__rova*` names and `__resizeObserverPatched` are the dev
    // hot-reload singletons on globalThis described in AGENTS.md. `_id` is the row
    // identity the key/value config editor holds outside the JSON it emits.
    "no-underscore-dangle": [
      "error",
      {
        "allow": [
          "_context",
          "_workflowComplete",
          "_g",
          "_intKey",
          "_rtKey",
          "_cacheKey",
          "_uiKey",
          "_id",
          "__rovaDatabaseState",
          "__rovaEncryptionState",
          "__rovaInngestState",
          "__rovaDevServer",
          "__rovaDevSignalsInstalled",
          "__resizeObserverPatched"
        ]
      }
    ],
    // This rule and tsconfig's noImplicitReturns are both on, because measurement
    // showed they cover different ground. The compiler option reports a function
    // whose control flow runs off the closing brace while another branch returned a
    // value; it says nothing about an explicit bare `return;`, which is a value
    // return of undefined as far as the checker is concerned. This rule reports
    // both. Enabling each one separately over the tree at the time gave 12 sites for
    // the compiler and 73 for the rule, and the 12 were not a subset: the compiler
    // alone found two fall-through gaps this rule missed, and this rule alone found
    // the bare-return mismatches in main.tsx, inngest/client.ts and step-registry.ts.
    // Every site is now written as an explicit `return undefined;`, so a function
    // that returns a value on one path states what it returns on all of them.
    "typescript/consistent-return": "error",
    "react/rules-of-hooks": "off",
    "react/exhaustive-deps": "off",
    "react-hooks-js/config": "error",
    "react-hooks-js/gating": "error",
    "react-hooks-js/rules-of-hooks": "error",
    "react-hooks-js/exhaustive-deps": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/void-use-memo": "error",
    "react-hooks-js/component-hook-factories": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/incompatible-library": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/unsupported-syntax": "error",
    // https://react.dev/learn/you-might-not-need-an-effect. An effect is for
    // synchronising with something outside React; each of these rules names a
    // case where the effect is instead computing a value React could have
    // computed during render, or reaching into a parent, or standing in for an
    // event handler. The client is mid-migration off effects entirely, so these
    // fail the build until every reported site is gone.
    "no-effect/no-derived-state": "error",
    "no-effect/no-chain-state-updates": "error",
    "no-effect/no-event-handler": "error",
    "no-effect/no-adjust-state-on-prop-change": "error",
    "no-effect/no-reset-all-state-on-prop-change": "error",
    "no-effect/no-pass-live-state-to-parent": "error",
    "no-effect/no-pass-data-to-parent": "error",
    "no-effect/no-external-store-subscription": "error",
    "no-effect/no-initialize-state": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          "navigate",
          "invalidateQueries",
          "refetchQueries",
          "cancelQueries",
          "resetQueries",
          "prefetchQuery",
          "prefetchInfiniteQuery"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "packages/core/client/**/*.ts",
        "packages/core/client/**/*.tsx",
        "packages/plugins/src/**/*.ts",
        "packages/plugins/src/**/*.tsx"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        // The no-effect rules infer whether an effect body is asynchronous by
        // looking at how promises are handled, so this has to be on wherever
        // those rules do their work.
        "typescript/no-floating-promises": "error",
        "react-hooks-js/incompatible-library": "off",
        // packages/core/client/hooks/effects.ts is the only file that calls
        // useEffect. Everything else reaches an effect through the hooks it
        // exports, which name what is being synchronised instead of leaving a
        // reader to work it out from a dependency array. An effect that does
        // not fit one of those hooks is usually not an effect: see
        // https://react.dev/learn/you-might-not-need-an-effect.
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "react",
                "importNames": ["useEffect", "useLayoutEffect"],
                // The UI primitives write `import type * as React` for
                // `ComponentProps`, and a type-only import cannot call
                // anything, so it is not what this rule is aimed at.
                "allowTypeImports": true,
                "message": "Use a named hook from @/hooks/effects. If none of them fits, the work probably belongs in an event handler, in render, or in a query."
              }
            ]
          }
        ]
      }
    },
    {
      // The blessed effects module: the one place in the client that may call
      // useEffect and useLayoutEffect directly. Everything else reaches an
      // effect through the named hooks it exports. The rules turned off below
      // are the ones whose whole subject matter is this file's job, so they
      // would fire on it by design. This override has to stay after the
      // packages/core/client one, because oxlint takes the last match.
      "files": ["packages/core/client/hooks/effects.ts"],
      "rules": {
        "no-restricted-imports": "off",
        "react-hooks-js/set-state-in-effect": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "packages/core/drizzle.config.ts",
        "packages/core/tsdown.config.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      // @rova/shared is the runtime-agnostic package: it declares its own npm
      // dependencies and nothing else, and both @rova/core and @rova/plugins
      // compile against its source through path aliases. Nothing may point the
      // other way.
      //
      // Bun's isolated linker enforces that for npm specifiers, because a package
      // only gets a node_modules holding what it declared. It cannot see an import
      // written as a tsconfig path alias: tsc and the bundler both resolve
      // `@/backend/lib/logger` from packages/shared straight to
      // packages/core/src/backend/lib/logger.ts with no manifest consulted, which
      // hands shared the whole of core and every dependency core declares. That is
      // what this rule covers. `@/*` resolves against packages/shared/src first,
      // so the groups below name the directory prefixes that exist only in core:
      // `backend` for the server, and the SPA's top-level folders.
      "files": ["packages/shared/src/**/*.ts", "packages/shared/src/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "@/backend",
                  "@/backend/**",
                  "@/components/**",
                  "@/hooks/**",
                  "@/lib/**",
                  "@/routes/**",
                  "@rova/core",
                  "@rova/core/**",
                  "@rova/plugins",
                  "@rova/plugins/**",
                  "../../core/**",
                  "../../plugins/**",
                  "../../../core/**",
                  "../../../plugins/**"
                ],
                "message": "@rova/shared cannot import @rova/core or @rova/plugins source. Shared is the bottom of the dependency graph: move the shared piece into packages/shared, or invert the call so core passes it in."
              }
            ]
          }
        ]
      }
    },
    {
      "files": [
        "server.ts",
        "packages/core/src/app.ts",
        "packages/plugins/src/ui.ts",
        "packages/core/client/main.tsx",
        "packages/core/client/components/flow-elements/canvas.tsx",
        "packages/core/client/components/workflow/workflow-canvas.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test-setup.ts",
        "**/test-matchers.ts",
        "**/test-utils.ts",
        "**/test-utils/**/*.ts",
        "**/test-utils/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx"
      ],
      "rules": {
        "no-undef": "off",
        "no-console": "off",
        "no-await-in-loop": "off",
        "eqeqeq": "off",
        "import/no-unassigned-import": "off",
        "react/react-in-jsx-scope": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/await-thenable": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-base-to-string": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "settings": {
    "typescript": {
      "tsconfig": "./tsconfig.json"
    }
  },
  "ignorePatterns": ["node_modules", "dist", "*.d.ts"]
}
