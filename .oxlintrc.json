{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "import", "unicorn"],
  "jsPlugins": [
    { "name": "react-hooks-js", "specifier": "eslint-plugin-react-hooks" }
  ],
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error"
  },
  "rules": {
    "no-unused-vars": "error",
    "no-undef": "error",
    "no-console": "off",
    "no-var": "error",
    "prefer-const": "error",
    // A leading underscore marks an identifier this codebase deliberately does not
    // consume: unused callback parameters (_context), the dev hot-reload singletons
    // declared on globalThis (__rovaDatabaseState and friends, see AGENTS.md), and the
    // `_integrationType` marker every plugin step exports for the step registry to read
    // across the plugins/core boundary. Obeying this rule would make no-unused-vars fire
    // on the same names and would break a documented cross-package contract. Oxlint files
    // it under the `suspicious` category, which this config enables wholesale.
    "no-underscore-dangle": "off",
    // typescript-eslint's own documentation for this rule says to prefer tsconfig's
    // noImplicitReturns, because that is driven by the compiler's control-flow analysis
    // and covers more ground. Here the rule reports 69 sites where the compiler reports
    // 12. Most of the surplus is a bare `return;` supplying the undefined branch of a
    // helper already declared `T | undefined`, which strict mode already proves. The rest
    // is idiomatic framework code: a React effect returning a cleanup only on the branch
    // that started a timer, and Hono middleware answering with a Response on a match
    // while falling through to next() otherwise. Turning noImplicitReturns on is its own
    // piece of work, since those 12 compiler sites include the React and Hono shapes.
    "typescript/consistent-return": "off",
    "react/rules-of-hooks": "off",
    "react/exhaustive-deps": "off",
    "react-hooks-js/config": "error",
    "react-hooks-js/gating": "error",
    "react-hooks-js/rules-of-hooks": "error",
    "react-hooks-js/exhaustive-deps": "error",
    "react-hooks-js/static-components": "error",
    "react-hooks-js/use-memo": "error",
    "react-hooks-js/void-use-memo": "error",
    "react-hooks-js/component-hook-factories": "error",
    "react-hooks-js/preserve-manual-memoization": "error",
    "react-hooks-js/incompatible-library": "error",
    "react-hooks-js/immutability": "error",
    "react-hooks-js/globals": "error",
    "react-hooks-js/refs": "error",
    "react-hooks-js/set-state-in-effect": "error",
    "react-hooks-js/error-boundaries": "error",
    "react-hooks-js/purity": "error",
    "react-hooks-js/set-state-in-render": "error",
    "react-hooks-js/unsupported-syntax": "error",
    "typescript/no-deprecated": "error",
    "typescript/no-floating-promises": [
      "error",
      {
        "allowForKnownSafeCalls": [
          "navigate",
          "invalidateQueries",
          "refetchQueries",
          "cancelQueries",
          "resetQueries",
          "prefetchQuery",
          "prefetchInfiniteQuery"
        ]
      }
    ]
  },
  "overrides": [
    {
      "files": ["**/*.ts", "**/*.tsx", "**/*.mts", "**/*.cts"],
      "rules": {
        "no-undef": "off"
      }
    },
    {
      "files": [
        "packages/core/client/**/*.ts",
        "packages/core/client/**/*.tsx",
        "packages/plugins/src/**/*.ts",
        "packages/plugins/src/**/*.tsx"
      ],
      "env": {
        "browser": true
      },
      "rules": {
        "react/react-in-jsx-scope": "off",
        "typescript/no-floating-promises": "off",
        "react-hooks-js/incompatible-library": "off"
      }
    },
    {
      "files": [
        "scripts/**/*.ts",
        "packages/core/drizzle.config.ts",
        "packages/core/tsdown.config.ts"
      ],
      "env": {
        "node": true
      }
    },
    {
      "files": [
        "server.ts",
        "packages/core/src/hono.ts",
        "packages/core/src/server.ts",
        "packages/plugins/src/ui.ts",
        "packages/core/client/main.tsx",
        "packages/core/client/components/flow-elements/canvas.tsx",
        "packages/core/client/components/workflow/workflow-canvas.tsx"
      ],
      "rules": {
        "import/no-unassigned-import": "off"
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.test.tsx",
        "**/*.spec.ts",
        "**/*.spec.tsx",
        "**/test-setup.ts",
        "**/test-matchers.ts",
        "**/test-utils.ts",
        "**/test-utils/**/*.ts",
        "**/test-utils/**/*.tsx",
        "**/__tests__/**/*.ts",
        "**/__tests__/**/*.tsx",
        "**/tests/**/*.ts",
        "**/tests/**/*.tsx"
      ],
      "rules": {
        "no-undef": "off",
        "no-console": "off",
        "no-await-in-loop": "off",
        "eqeqeq": "off",
        "import/no-unassigned-import": "off",
        "react/react-in-jsx-scope": "off",
        "typescript/no-unnecessary-type-assertion": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/await-thenable": "off",
        "typescript/require-array-sort-compare": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-base-to-string": "off",
        "unicorn/no-array-sort": "off",
        "unicorn/consistent-function-scoping": "off"
      }
    }
  ],
  "settings": {
    "typescript": {
      "tsconfig": "./tsconfig.json"
    }
  },
  "ignorePatterns": ["node_modules", "dist", "*.d.ts"]
}
