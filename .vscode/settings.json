{
  // oxfmt owns every language listed below, and `pnpm run check` (oxfmt --check)
  // gates them in CI. Each one is pinned to the oxc extension so that an editor
  // save produces byte-identical output to the CI check. Markdown matters most
  // here: oxfmt pads table cells to a uniform column width, so a save handled by
  // any other formatter reformats tables and fails the check.
  "[javascript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescript]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[javascriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[typescriptreact]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[json]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[jsonc]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[css]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[scss]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[less]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[graphql]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[html]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[markdown]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  "[yaml]": {
    "editor.defaultFormatter": "oxc.oxc-vscode"
  },
  // The TypeScript 7 extension (TypeScriptTeam.native-preview) runs tsrs as its
  // language server, the same compiler `pnpm run type-check` runs, so the editor
  // and the check agree. The extension starts the executable named `tsgo` in
  // `js/ts.tsdk.path` with `--lsp --stdio`, and tsrs ships one in its `tsdk`
  // directory. `prepare` patches the installed tsrs with the Effect build, which
  // loads the Effect language service plugin configured in tsconfig.json. The
  // extension asks once for consent before it runs a workspace compiler.
  "js/ts.experimental.useTsgo": true,
  "js/ts.tsdk.path": "./node_modules/tsrs/tsdk",
  "js/ts.tsdk.promptToUseWorkspaceVersion": true,
  "editor.formatOnSave": true,
  // oxfmt formats whole files only, so a save that asked for just the changed
  // ranges would be dropped. "file" is VS Code's default; it is written out here
  // so a developer's global "modifications" preference cannot silently turn
  // format-on-save into a no-op for this workspace.
  "editor.formatOnSaveMode": "file",
  "editor.formatOnPaste": true,
  "emmet.showExpandedAbbreviation": "never",
  "editor.codeActionsOnSave": {
    "source.fixAll.oxc": "explicit"
  }
}
