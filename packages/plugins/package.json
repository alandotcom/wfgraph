{
  "name": "@wfgraph/plugins",
  "version": "3.1.1",
  "description": "The six built-in Workflow Graph integrations, plus the icons and output renderers the editor draws them with",
  "keywords": [
    "automation",
    "clerk",
    "integrations",
    "linear",
    "posthog",
    "tanstack-intent",
    "workflow"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandotcom/wfgraph.git",
    "directory": "packages/plugins"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@clerk/backend": "^2.33.6",
    "@linear/sdk": "^75.0.0",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "svix": "^2.1.0"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@wfgraph/core": "workspace:*",
    "@wfgraph/shared": "workspace:*",
    "react": "catalog:",
    "resend": "^6.25.0"
  },
  "peerDependencies": {
    "@wfgraph/core": "*"
  },
  "engines": {
    "node": ">=24"
  }
}
