{
  "name": "@wfgraph/plugins",
  "version": "4.2.0",
  "description": "The six built-in Workflow Graph integrations, one entry each, plus the icons and output renderers the editor draws them with",
  "keywords": [
    "automation",
    "clerk",
    "integrations",
    "linear",
    "posthog",
    "tanstack-intent",
    "workflow"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandotcom/wfgraph.git",
    "directory": "packages/plugins"
  },
  "files": [
    "dist",
    "skills"
  ],
  "type": "module",
  "imports": {
    "#src/*": "./src/*.js"
  },
  "exports": {
    "./clerk": {
      "types": "./dist/clerk.d.ts",
      "default": "./dist/clerk.js"
    },
    "./linear": {
      "types": "./dist/linear.d.ts",
      "default": "./dist/linear.js"
    },
    "./posthog": {
      "types": "./dist/posthog.d.ts",
      "default": "./dist/posthog.js"
    },
    "./resend": {
      "types": "./dist/resend.d.ts",
      "default": "./dist/resend.js"
    },
    "./slack": {
      "types": "./dist/slack.d.ts",
      "default": "./dist/slack.js"
    },
    "./twilio": {
      "types": "./dist/twilio.d.ts",
      "default": "./dist/twilio.js"
    },
    "./ui": {
      "types": "./dist/ui.d.ts",
      "default": "./dist/ui.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "svix": "^2.9.1"
  },
  "devDependencies": {
    "@types/react": "catalog:",
    "@wfgraph/core": "workspace:*",
    "@wfgraph/shared": "workspace:*",
    "react": "catalog:"
  },
  "peerDependencies": {
    "@wfgraph/core": "*"
  },
  "engines": {
    "node": ">=24"
  }
}
