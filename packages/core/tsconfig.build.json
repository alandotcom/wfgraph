{
  // bunup reads this file only for module/path resolution while it bundles and
  // generates the .d.ts files in dist. It never runs the TypeScript emitter, so
  // declaration settings here would be dead config.
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "types": ["bun-types", "node"],
    "paths": {
      "@rova/shared": ["../shared/src"],
      "@rova/plugins": ["../plugins/src/index.ts"],
      "@rova/plugins/*": ["../plugins/src/*"],
      "@/shared/*": ["../shared/src/*"],
      "@/backend/*": ["./src/backend/*"],
      "@/plugins/*": ["../shared/src/plugins/*", "../plugins/src/*"],
      "@/*": ["../shared/src/*", "./src/*", "./client/*", "../plugins/src/*"]
    }
  },
  "include": ["src/index.ts", "src/hono.ts", "src/**/*.ts", "src/**/*.tsx"]
}
