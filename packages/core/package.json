{
  "name": "@wfgraph/core",
  "version": "4.0.0",
  "description": "Workflow Graph's backend: the run engine, the authoring vocabulary and the app a host mounts",
  "keywords": [
    "automation",
    "effect",
    "inngest",
    "tanstack-intent",
    "workflow",
    "workflow-engine"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandotcom/wfgraph.git",
    "directory": "packages/core"
  },
  "files": [
    "dist",
    "drizzle",
    "drizzle-sqlite",
    "skills"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    },
    "./logging": {
      "types": "./dist/logging.d.ts",
      "default": "./dist/logging.js"
    },
    "./postgres": {
      "types": "./dist/postgres.d.ts",
      "default": "./dist/postgres.js"
    },
    "./sqlite": {
      "types": "./dist/sqlite.d.ts",
      "default": "./dist/sqlite.js"
    },
    "./worker": {
      "types": "./dist/worker.d.ts",
      "default": "./dist/worker.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./inngest": {
      "types": "./dist/inngest.d.ts",
      "default": "./dist/inngest.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@effect/ai-openai": "catalog:",
    "@effect/opentelemetry": "catalog:",
    "@effect/sql-sqlite-node": "catalog:",
    "@hono/node-server": "^2.1.6",
    "@logtape/logtape": "catalog:",
    "@marcbachmann/cel-js": "catalog:",
    "@modelcontextprotocol/server": "2.4.0",
    "@opentelemetry/api": "catalog:",
    "@opentelemetry/resources": "^2.12.0",
    "@opentelemetry/semantic-conventions": "^1.44.0",
    "@orpc/contract": "catalog:",
    "@orpc/effect": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@standard-schema/spec": "catalog:",
    "croner": "catalog:",
    "drizzle-orm": "1.0.0-rc.5",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "graphology": "catalog:",
    "postgres": "catalog:",
    "uuid": "catalog:"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.6",
    "@inngest/test": "^1.0.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@opentelemetry/sdk-trace-base": "catalog:",
    "@types/express": "^5.0.6",
    "@wfgraph/agent": "workspace:*",
    "@wfgraph/shared": "workspace:*",
    "arktype": "catalog:",
    "express": "^5.3.0",
    "fast-check": "catalog:",
    "fastify": "^5.12.8",
    "hono": "catalog:",
    "inngest": "catalog:",
    "zod": "catalog:"
  },
  "peerDependencies": {
    "hono": "catalog:",
    "inngest": "catalog:"
  },
  "peerDependenciesMeta": {
    "inngest": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  }
}
