{
  "name": "@rova/core",
  "version": "0.0.0",
  "license": "Apache-2.0",
  "files": [
    "dist",
    "drizzle"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "imports": {
    "#src/*": "./src/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./app": {
      "types": "./dist/app.d.ts",
      "default": "./dist/app.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./plugin": {
      "types": "./dist/plugin.d.ts",
      "default": "./dist/plugin.js"
    },
    "./migrate": {
      "types": "./dist/migrate.d.ts",
      "default": "./dist/migrate.js"
    }
  },
  "scripts": {
    "build": "tsdown"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.12",
    "@logtape/logtape": "^2.0.2",
    "@logtape/pretty": "^2.0.2",
    "@marcbachmann/cel-js": "catalog:",
    "@opentelemetry/api": "^1.9.0",
    "@orpc/contract": "catalog:",
    "@orpc/experimental-effect": "catalog:",
    "@orpc/openapi": "catalog:",
    "@orpc/server": "catalog:",
    "@standard-schema/spec": "catalog:",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "^0.45.1",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "graphology": "catalog:",
    "graphology-dag": "^0.4.1",
    "hono": "^4.11.9",
    "inngest": "^4.13.0",
    "nanoid": "catalog:",
    "postgres": "catalog:"
  },
  "devDependencies": {
    "@fastify/middie": "^9.3.3",
    "@inngest/test": "^1.0.0",
    "@opentelemetry/sdk-trace-base": "^2.10.0",
    "@rova/shared": "workspace:*",
    "@types/express": "^5.0.6",
    "express": "^5.2.1",
    "fastify": "^5.10.0"
  }
}
