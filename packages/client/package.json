{
  "name": "@wfgraph/client",
  "version": "2.3.0",
  "description": "Workflow Graph's node-based editor, built and handed to createWfGraphApp as its client bundle",
  "keywords": [
    "automation",
    "react-flow",
    "workflow",
    "workflow-editor"
  ],
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alandotcom/wfgraph.git",
    "directory": "packages/client"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#src/*.css": "./src/*.css",
    "#src/*": "./src/*.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsdown && vite build",
    "theme:build": "astryx theme build src/theme/wfgraph-theme.ts"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.4.5",
    "@astryxdesign/core": "catalog:",
    "@babel/core": "^7.29.7",
    "@base-ui/react": "1.7.0",
    "@dagrejs/dagre": "^2.0.4",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@logtape/logtape": "catalog:",
    "@orpc/client": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/tanstack-query": "catalog:",
    "@rolldown/plugin-babel": "^0.2.3",
    "@stylexjs/stylex": "catalog:",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.25",
    "@testing-library/react": "catalog:",
    "@types/babel__core": "^7.20.5",
    "@types/react": "catalog:",
    "@vitejs/plugin-react": "^6.0.5",
    "@wfgraph/plugins": "workspace:*",
    "@wfgraph/shared": "workspace:*",
    "@xyflow/react": "catalog:",
    "babel-plugin-react-compiler": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "d3-hierarchy": "^3.1.2",
    "effect": "catalog:",
    "es-toolkit": "catalog:",
    "jotai": "^2.20.2",
    "lucide-react": "^0.563.0",
    "motion": "^12.43.0",
    "nanoid": "catalog:",
    "next-themes": "^0.4.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2",
    "vite": "catalog:"
  },
  "engines": {
    "node": ">=24"
  }
}
