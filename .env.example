# Required by the example app. Generate one with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Optional. Enables the build agent in the editor.
OPENAI_API_KEY=

# Optional. Enables "Connect with Slack" (OAuth) for the Slack integration. The Slack
# app's redirect URL must be <server origin>/api/integrations/oauth/callback
# (http://localhost:4017/api/integrations/oauth/callback in development).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
