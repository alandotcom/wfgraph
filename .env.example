# Required by the example app. Generate one with: openssl rand -hex 32
INTEGRATION_ENCRYPTION_KEY=

# Optional. Enables the build agent in the editor.
OPENAI_API_KEY=

# Optional. Enables "Connect with Slack" (OAuth) for the Slack integration. The Slack
# app's redirect URL must be <server origin>/api/integrations/oauth/callback
# (http://localhost:4017/api/integrations/oauth/callback in development).
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=

# Optional. Only the live PostgreSQL suite (pnpm run test:postgres) reads this, and
# without it that suite skips itself. `docker compose up -d` serves the URL below.
# Keep it off any database you keep anything in: each test file creates a schema,
# migrates it and drops it again.
# WFGRAPH_TEST_DATABASE_URL=postgresql://workflow:workflow@localhost:55437/workflow_builder
