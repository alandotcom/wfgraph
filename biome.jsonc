{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/core", "ultracite/react"],
  "linter": {
    "rules": {
      "style": {
        "useConsistentTypeDefinitions": "off"
      }
    }
  },
  "javascript": {
    "globals": ["Bun"]
  },
  "overrides": [
    {
      "includes": ["packages/core/client/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/backend/**"],
                    "message": "Client-side code cannot import backend modules."
                  },
                  {
                    "group": ["../*", "../**"],
                    "message": "Use @/ aliases instead of cross-folder relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/core/src/backend/**"],
      "javascript": {
        "globals": ["Bun"]
      },
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/client/**"],
                    "message": "Backend code cannot import client modules."
                  },
                  {
                    "group": ["../*", "../**"],
                    "message": "Use @/ aliases instead of cross-folder relative imports."
                  }
                ]
              }
            }
          },
          "performance": {
            "noBarrelFile": "off"
          }
        }
      }
    },
    {
      "includes": ["packages/shared/src/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["@/backend/**"],
                    "message": "Shared code must stay runtime-agnostic."
                  },
                  {
                    "group": ["@/client/**"],
                    "message": "Shared code must stay runtime-agnostic."
                  },
                  {
                    "group": ["../*", "../**"],
                    "message": "Use @/ aliases instead of cross-folder relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["packages/plugins/src/**"],
      "linter": {
        "rules": {
          "a11y": {
            "noSvgWithoutTitle": "off"
          },
          "complexity": {
            "noExcessiveCognitiveComplexity": "off",
            "useOptionalChain": "off"
          },
          "performance": {
            "noBarrelFile": "off"
          },
          "style": {
            "useBlockStatements": "off",
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": ["../*", "../**"],
                    "message": "Use @/ aliases instead of cross-folder relative imports."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "packages/core/src/backend/server/index.ts",
        "packages/core/client/lib/rpc-client.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": "off"
          }
        }
      }
    }
  ],
  "files": {
    "includes": [
      "**/*",
      "!packages/core/client/components/ui",
      "!packages/core/client/components/flow-elements",
      "!packages/core/client/hooks/use-mobile.ts"
    ]
  }
}
